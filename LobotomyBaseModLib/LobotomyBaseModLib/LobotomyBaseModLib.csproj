<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>LobotomyBaseModLib</AssemblyName>
    <RootNamespace>LobotomyBaseModLib</RootNamespace>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>NU1903</NoWarn>
    <GameManaged Condition="'$(GameManaged)' == '' and '$(LMM_GAME_MANAGED)' != ''">$(LMM_GAME_MANAGED)</GameManaged>
    <GameManaged Condition="'$(GameManaged)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\external\Managed\UnityEngine.CoreModule.dll')">$(MSBuildThisFileDirectory)..\..\external\Managed</GameManaged>
    <GameManaged Condition="'$(GameManaged)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\..\game-files-do-not-publish\Managed\UnityEngine.CoreModule.dll')">$(MSBuildThisFileDirectory)..\..\..\..\game-files-do-not-publish\Managed</GameManaged>
  </PropertyGroup>

  <Target Name="ValidatePrivateBuildReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameManaged)' == '' Or !Exists('$(GameManaged)/UnityEngine.CoreModule.dll')" Text="Supply -p:GameManaged=&lt;path-to-Managed&gt; containing UnityEngine.dll and UnityEngine.CoreModule.dll." />
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>LobotomyBaseMod.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Mono.Cecil" Version="0.10.4" />
    <PackageReference Include="Newtonsoft.Json" Version="3.5.8" />
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
