<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <PatcherDependencies Condition="'$(PatcherDependencies)' == ''">$(MSBuildThisFileDirectory)..\LMM\Assets\Patcher</PatcherDependencies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LobotomyBaseModPatcher\LobotomyBaseModPatcher\LobotomyBaseModPatcher.csproj" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(PatcherDependencies)\Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="Patchwork.Engine">
      <HintPath>$(PatcherDependencies)\Patchwork.Engine.dll</HintPath>
    </Reference>
    <Reference Include="Patchwork.Attributes">
      <HintPath>$(PatcherDependencies)\Patchwork.Attributes.dll</HintPath>
    </Reference>
    <Reference Include="Serilog">
      <HintPath>$(PatcherDependencies)\Serilog.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
