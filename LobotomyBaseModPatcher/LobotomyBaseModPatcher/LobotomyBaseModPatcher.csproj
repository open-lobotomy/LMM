<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LobotomyPatcher</AssemblyName>
    <RootNamespace>LobotomyPatcher</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PatcherDependencies Condition="'$(PatcherDependencies)' == ''">$(MSBuildProjectDirectory)\..\..\LMM\Assets\Patcher</PatcherDependencies>
  </PropertyGroup>

  <Target Name="ValidatePrivateBuildReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(PatcherDependencies)' == '' Or !Exists('$(PatcherDependencies)/Patchwork.Engine.dll') Or !Exists('$(PatcherDependencies)/Mono.Cecil.dll') Or !Exists('$(PatcherDependencies)/Serilog.dll')" Text="Supply -p:PatcherDependencies=&lt;path-to-Patcher&gt; containing Patchwork.Engine.dll, Mono.Cecil.dll, and Serilog.dll." />
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>LobotomyBaseMod.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Patchwork.Engine">
      <HintPath>$(PatcherDependencies)/Patchwork.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Serilog">
      <HintPath>$(PatcherDependencies)/Serilog.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(PatcherDependencies)/Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
