<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>Lobotomypatch</AssemblyName>
    <RootNamespace>Lobotomypatch</RootNamespace>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GameManaged Condition="'$(GameManaged)' == '' and '$(LMM_GAME_MANAGED)' != ''">$(LMM_GAME_MANAGED)</GameManaged>
    <GameManaged Condition="'$(GameManaged)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\external\Managed\Assembly-CSharp.dll')">$(MSBuildThisFileDirectory)..\..\external\Managed</GameManaged>
    <GameManaged Condition="'$(GameManaged)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\..\game-files-do-not-publish\Managed\Assembly-CSharp.dll')">$(MSBuildThisFileDirectory)..\..\..\..\game-files-do-not-publish\Managed</GameManaged>
  </PropertyGroup>

  <Target Name="ValidatePrivateBuildReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameManaged)' == '' Or !Exists('$(GameManaged)/Assembly-CSharp.dll')" Text="Supply -p:GameManaged=&lt;path-to-Managed&gt; containing Assembly-CSharp.dll and UnityEngine*.dll." />
  </Target>

  <ItemGroup>
    <PackageReference Include="HarmonyX" Version="2.10.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\..\LobotomyBaseModLib\LobotomyBaseModLib\LobotomyBaseModLib.csproj">
      <Private>false</Private>
    </ProjectReference>
    <Reference Include="Patchwork.Attributes">
      <HintPath>$(MSBuildThisFileDirectory)..\..\LMM\Assets\Patcher\Patchwork.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NAudio">
      <HintPath>$(MSBuildThisFileDirectory)..\..\LMM\Assets\PatchFiles\NAudio</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManaged)/Assembly-CSharp.dll;$(GameManaged)/UnityEngine*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
